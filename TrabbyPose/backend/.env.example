# Trabby Pose Backend - Environment Variables Template
# Copy this file to .env and fill in your actual values

# ============================================================================
# Django Security Settings
# ============================================================================

# Secret key for Django (generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
SECRET_KEY=your-django-secret-key-here-change-this-in-production

# Debug mode (NEVER set to True in production!)
DEBUG=True

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,sandbox1.advancedthinkers.app

# ============================================================================
# Database Configuration
# ============================================================================

# For SQLite (development):
DATABASE_URL=sqlite:///db.sqlite3

# For PostgreSQL (production recommended):
# DATABASE_URL=postgresql://username:password@localhost:5432/trabby_pose

# ============================================================================
# CORS Configuration (for Frontend Communication)
# ============================================================================

# Allowed origins for cross-origin requests (comma-separated)
# Frontend development servers
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4321

# ============================================================================
# Optional: Logging Configuration
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path (optional)
# LOG_FILE=/path/to/logs/django.log

# ============================================================================
# Optional: Email Configuration (for future features)
# ============================================================================

# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# ============================================================================
# Notes
# ============================================================================
# - Rename this file to .env (without .example)
# - Never commit .env to version control
# - For production, use strong SECRET_KEY and DEBUG=False
# - Ensure DATABASE_URL points to your PostgreSQL instance
# - Update CORS_ALLOWED_ORIGINS to match your frontend URL
