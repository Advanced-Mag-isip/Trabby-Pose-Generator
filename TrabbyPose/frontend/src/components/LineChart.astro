---
// src/components/LineChart.astro

interface Props {
  chartId?: string;
  labels: string[];
  values: number[];
  label?: string;
}

const {
  chartId = "default-line-chart",
  labels = [],
  values = [],
  label = "Data Overview"
} = Astro.props;

const maxVal = values.length > 0 ? Math.max(...values) : 0;

// Build points
const points = values.map((value, index) => {
  const x = labels.length > 1 ? (index / (labels.length - 1)) * 90 + 5 : 50;
  const y = maxVal > 0 ? 90 - (value / maxVal) * 80 : 90;

  return { x, y, value, label: labels[index] };
});

const pathD = points
  .map((p, i) => `${i === 0 ? "M" : "L"} ${p.x} ${p.y}`)
  .join(" ");
---

<div class="chart-container" id={chartId}>
  <h3 class="chart-title">{label}</h3>

  {values.length === 0 ? (
    <div class="chart-error">No data available for this timeframe.</div>
  ) : (
    <div class="chart-wrapper">

      <!-- Y AXIS LABELS -->
      <div class="y-axis">
        <span>{maxVal}</span>
        <span>{Math.round(maxVal / 2)}</span>
        <span>0</span>
      </div>

      <!-- SVG CHART -->
      <svg viewBox="0 0 100 100" class="line-svg">

        <!-- GRID LINES -->
        <line x1="5" y1="10" x2="95" y2="10" stroke="#eee" />
        <line x1="5" y1="50" x2="95" y2="50" stroke="#eee" />
        <line x1="5" y1="90" x2="95" y2="90" stroke="#eee" />

        <!-- AXES -->
        <line x1="5" y1="10" x2="5" y2="90" stroke="#ccc" />
        <line x1="5" y1="90" x2="95" y2="90" stroke="#ccc" />

        <!-- LINE -->
        <path
          d={pathD}
          fill="none"
          stroke="#3b82f6"
          stroke-width="2"
        />

        <!-- POINTS -->
        {points.map((p) => (
          <circle cx={p.x} cy={p.y} r="2" fill="#3b82f6">
            <title>{`${p.label}: ${p.value}`}</title>
          </circle>
        ))}

      </svg>
    </div>
  )}

  <!-- X AXIS LABELS -->
  <div class="x-axis">
    {labels.map((l) => (
      <span>{l}</span>
    ))}
  </div>
</div>

<style>
  .chart-container {
    width: 100%;
    max-width: 600px;
    margin: 2rem auto;
    padding: 1.5rem;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    background: #fff;
    font-family: system-ui;
  }

  .chart-title {
    text-align: center;
    font-weight: 600;
    margin-bottom: 1rem;
    color: #1f2937;
  }

  .chart-wrapper {
    display: flex;
    align-items: center;
  }

  .y-axis {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 220px;
    font-size: 0.7rem;
    color: #6b7280;
    padding-right: 6px;
  }

  .line-svg {
    width: 100%;
    height: 220px;
  }

  .x-axis {
    display: flex;
    justify-content: space-between;
    font-size: 0.7rem;
    color: #6b7280;
    margin-top: 6px;
  }

  .x-axis span {
    flex: 1;
    text-align: center;
  }

  .chart-error {
    text-align: center;
    color: #9ca3af;
    padding: 2rem;
  }
</style>