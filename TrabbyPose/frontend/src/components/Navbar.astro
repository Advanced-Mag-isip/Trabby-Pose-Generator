---
import { Image } from 'astro:assets';
import trabahadoorLogo from '../assets/trabahadoor-logo.svg?raw';
import logoutIcon from '../assets/icons/log-out.svg?raw';
import '../styles/global.css';
const currentPath = Astro.url.pathname;
---

<nav id="main-navigation">
    <div class="nav-safe-area">
        <a href="/" id="nav-logo">
            <Fragment set:html={trabahadoorLogo} />
        </a>
        <div id="nav-links">
            <a href="/Customization" class={currentPath === '/Customization' ? 'active' : ''}>Customization</a>
            <a href="/Gallery" class={currentPath === '/Gallery' ? 'active' : ''}>Gallery</a>
            <a href="/Insights" class={currentPath === '/Insights' ? 'active' : ''}>Insights</a>
            <a href="/UserAccounts" class={currentPath === '/UserAccounts' ? 'active' : ''}>Settings</a>
        </div>
        <div id="nav-actions">
            <button id="log-out-btn">
                <span>Log-out &nbsp;</span>
                <Fragment set:html={logoutIcon} alt="User"/>
            </button>
        </div>
    </div>
</nav>

<script>
    const logoutBtn = document.getElementById('log-out-btn');

    logoutBtn?.addEventListener('click', async (e) => {
        e.preventDefault();

        try {
            // Point this to your Django backend
            const BACKEND_URL = 'http://127.0.0.1:8000'; 
            
            // Call the Django logout view you wrote earlier
            const response = await fetch(`${BACKEND_URL}/api/auth/logout/`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                // CRITICAL: This sends the HTTP-Only cookie to Django so it knows who to log out
                credentials: 'include', 
            });

            if (response.ok) {
                // Django successfully deleted the cookies! 
                window.location.href = '/UserLogin';
            } else {
                console.error("Logout failed on the server.");
                // Force redirect anyway as a fallback safety measure
                window.location.href = '/UserLogin';
            }
        } catch (error) {
            console.error("Network error during logout:", error);
            window.location.href = '/UserLogin';
        }
    });

     window.addEventListener('pageshow', (event) => {
    // event.persisted is TRUE if the page was loaded from the Back/Forward cache
    if (event.persisted) {
      // Force the browser to request a fresh copy from the server
      window.location.reload();
    }
  });
</script>

<style>
    #main-navigation {
        background-color: #ffffff10;
        backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--light-gray);
        width: 100%;
        position: sticky;
        top: 0;
        z-index: 1000;
    }

    .nav-safe-area {
        max-width: 1400px;
        margin: 0 auto;
        padding: 1rem 30px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-sizing: border-box;
        flex-wrap: wrap;
    }

    #nav-logo :global(svg) {
        width: 140px;
        height: auto;
    }

    #nav-links {
        display: flex;
        gap: 10px;
        margin: 0;
        align-items: center;
    }

    #nav-links a {
        color: var(--blue);
        text-decoration: none;
        font-family: 'Sora', sans-serif;
        font-weight: bold;
        padding: 10px 15px;
        border-radius: 2rem;
        transition: background-color 0.3s, color 0.3s;
        white-space: nowrap;
    }

    #nav-links a:hover {
        color: var(--orange);
        background-color: var(--light-gray);
    }

    #nav-links a.active {
        color: var(--white);
        background-color: var(--blue);
    }

    #nav-actions {
        display: flex;
        align-items: center;
    }
    
#log-out-btn {
   
    background: none;
    border: none;
    font-size: 1rem; 
    
   
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: row;
    width: auto;
    height: 40px;
    border-radius: 2rem; 
    cursor: pointer;
    transition: background-color 0.3s ease;
    text-decoration: none;
    color: var(--blue);
    font-weight: bold;
    padding: 0px 15px;
}
    #log-out-btn :global(svg) {
        width: 24px;
        height: 24px;
        stroke: var(--blue); 
        transition: fill 0.4s ease;
    }

    


    #log-out-btn:hover {
        background-color: var(--blue);
        color: var(--white)
    }
    
    #log-out-btn:hover :global(svg) {
        stroke: var(--white); 
    }




    @media (max-width: 900px) {
        #nav-links {
            gap: 5px;
        }
        
        #nav-links a {
            padding: 8px 10px;
            font-size: 0.9rem;
        }
    }

    @media (max-width: 768px) {
        .nav-safe-area {
            padding: 1rem 15px;
        }
        
        #nav-links {
            order: 3;
            width: 100%;
            justify-content: center;
            margin-top: 15px;
            flex-wrap: wrap;
        }
    }
</style>