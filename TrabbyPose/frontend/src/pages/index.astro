---
// src/pages/index.astro

import { Image } from 'astro:assets';
import trabbyImage from '../assets/trabby/model/trabby.png';
import trabbyBody from '../assets/trabby/model/trabby-body.png';
import trabbyWave from '../assets/trabby/model/trabby-arm-wave.png';
// import { fetchTest } from '../lib/api'; API endpoints, uncomment to connect to django
// const apiTestData = await fetchTest(); API endpoints, uncomment to connect to django
---

<!doctype html>
<html lang="en">
    <head>
        <link href="https://googleapis.com" rel="stylesheet">
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="generator" content={Astro.generator} />
        <title>Trabbyhadoor</title>

        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;700&display=swap" rel="stylesheet">
    </head>
    <body>
        <div class="ultramaincontainer">
            <div id="main-container">
                <div id="app-title">
                    <div id="trabbyhadoor">TrabbyHadoor</div>
                    <div id="customizer">Customizer</div>
                    <p>Trabahadoor’s mascot customization tool that allows users to customize Trabby by selecting different heads, torso, limbs, and accessories to create unique character assets.</p>
                    <div id="landing-button">
                        <a href="/UserLogin"><button>Start Customizing!</button></a>
                    </div>
                </div>

                <div id="trabby-container">
                    <Image class="trabby-body" src={trabbyBody} alt="TrabbyBody"></Image>
                    <Image class="trabby-wave" src={trabbyWave} alt="TrabbyWave"></Image>
                </div>
            </div>
        </div>
    </body>
</html>

<style>
    html, body {
        margin: 0;
        padding: 0;
        overflow-x: hidden;
    }

    .ultramaincontainer {
        min-height: 100vh;
        width: 100%;
        background-color: transparent;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 2rem;
        box-sizing: border-box;
        background-image: repeating-linear-gradient(
            -45deg,               
            transparent,
            transparent 10px,
            #e2e8f0 10px,
            #e2e8f0 11px
        );
    }

    #main-container {
        background-color: transparent;
        display: flex;
        flex-direction: row;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
        gap: 3rem; 
        max-width: 1200px;
        width: 100%;
        margin: 0 auto;
    }

    #app-title {
        font-size: clamp(40px, 5vw + 1rem, 75px);
        font-family: 'Sora', sans-serif; 
        font-weight: bold;
        display: flex;
        flex-direction: column;  
        justify-content: center;
        flex: 1 1 400px;
    }

    #trabbyhadoor { 
        color: #1A2B4A; 
        opacity: 0;
        animation: slideFadeUp 0.8s ease-out 0.1s forwards;
    }
    #customizer { 
        color: #F26B2A; 
        opacity: 0;
        animation: slideFadeUp 0.8s ease-out 0.3s forwards;
    }

    p {
        font-size: 1.1rem;
        max-width: 550px;
        width: 100%; 
        font-weight: normal;
        color: #666;
        line-height: 1.6;
        margin-bottom: 2rem;
        opacity: 0;
        animation: slideFadeUp 0.8s ease-out 0.5s forwards;
    }

    /* Button */
    #main-container button {
        width: fit-content;
        height: fit-content;
        padding: 15px 40px;
        font-size: 1rem;
        border: none;
        border-radius: 30px;
        font-family: 'Sora', sans-serif; 
        font-weight: bold;
        cursor: pointer;
        background-color: #1A2B4A;
        color: #FFFF;
        transition: all 0.3s ease;
    }

    button:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.50);
    }

    #trabby-container {
        position: relative;
        flex: 1 1 300px;
        max-width: 500px;
        width: 100%;
        aspect-ratio: 1 / 1;
        animation: hover 3s infinite ease-in-out;
        display: flex;
        justify-content: center;
        align-items: center;
        opacity: 0;
        animation: simpleFadeIn 0.8s ease-out 0.7s forwards;
    }

    #landing-button {
        opacity: 0;
        animation: slideFadeUp 0.8s ease-out 0.7s forwards;
    }

    img {
        max-width: 100%;
        max-height: 100%;
        width: auto;
        height: auto;
        object-fit: contain;
    }

    .trabby-body {
        position: absolute;
        z-index: 1;
    }

    .trabby-wave {
        position: absolute;
        z-index: 2;
        transform-origin: 60% 57%; 
        animation: wave 2.5s infinite ease-in-out;
    }

    /* Animations */
    @keyframes wave {
        0% { transform: rotate(0deg); }
        50% { transform: rotate(-35deg); }
        100% { transform: rotate(0deg); }
    }

    @keyframes hover {
        0% { transform: translateY(0px); }
        50% { transform: translateY(-15px); }
        100% { transform: translateY(0px); }
    }

    @keyframes slideFadeUp {
        0% {
            opacity: 0;
            transform: translateY(30px);
        }
        100% {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes simpleFadeIn {
        0% { opacity: 0; }
        100% { opacity: 1; }
    }

    /* Mobile Adjustments */
    @media (max-width: 768px) {
        #main-container {
            text-align: center;
            gap: 2rem;
        }

        #app-title {
            align-items: center;
        }
    }
</style>