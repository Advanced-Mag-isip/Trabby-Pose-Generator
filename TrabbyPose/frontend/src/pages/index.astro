---
// src/pages/index.astro
import '../styles/landingPage.css';
import { Image } from 'astro:assets';
import trabbyImage from '../assets/trabby/model/trabby.png';
---

<!doctype html>
<html lang="en">
	<head>
		<link href="https://googleapis.com" rel="stylesheet">
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Trabbyhadoor</title>
        <link href = /css/landingPage.css rel = "stylesheet">

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	
		<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;700&display=swap" rel="stylesheet">
	</head>
	<body>
        <div id = "main-container">
            <div id = "app-title">
                <div id = "trabbyhadoor">TrabbyHadoor</div>
                <div id = "customizer">Customizer</div>
                <div id = "landing-button"><a href="/Customization"><button>start</button></a></div>
            </div>

            <div id = "trabby-container">
                <Image src ={trabbyImage} alt = "Trabby">
            </div>
        </div>
	</body>
</html>
