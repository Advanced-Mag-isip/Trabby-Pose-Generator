<style>
  .content-container {
    display: flex;
    flex-direction: row;
    justify-content: center;
    gap: 1em;
    flex-wrap: wrap;
  }

  #panel-gallery {
    background-color: var(--white);
    flex: 1 1 1400px;
    min-width: 280px;
    max-width: 100%;
    border-radius: 24px;
    border: 4px solid var(--orange);
    overflow: hidden;
    box-shadow: var(--default-shadow);
    display: flex;
    flex-direction: column;
    height: clamp(450px, 75vh, 700px);
  }

  #panel-header-gallery {
    background-color: var(--orange);
    color: var(--white);
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 20px;
    font-family: 'Sora', sans-serif;
    font-weight: bold;
    font-size: 1.3em;
    flex-shrink: 0;
    gap: 16px;
  }

  .search-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    background-color: var(--white);
    border-radius: 50px;
    padding: 5px 14px;
    width: 220px;
    flex-shrink: 0;
  }

  .search-icon {
    color: var(--grey-text);
    flex-shrink: 0;
  }

  .search-bar input {
    border: none;
    outline: none;
    background: transparent;
    font-family: 'Sora', sans-serif;
    font-size: 0.8rem;
    color: var(--blue);
    width: 100%;
    min-width: 0;
  }

  .search-bar input::placeholder {
    color: var(--grey-text);
  }

  .gallery-scroll-area {
    flex: 1;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 16px;

    /* Real styled scrollbar — Firefox */
    scrollbar-width: thin;
    scrollbar-color: var(--orange) var(--light-gray);
  }

  /* Real styled scrollbar — Chrome/Safari/Edge */
  .gallery-scroll-area::-webkit-scrollbar {
    width: 8px;
  }

  .gallery-scroll-area::-webkit-scrollbar-track {
    background: var(--light-gray);
    border-radius: 10px;
    margin: 8px 0;
  }

  .gallery-scroll-area::-webkit-scrollbar-thumb {
    background-color: var(--orange);
    border-radius: 10px;
  }

  .gallery-scroll-area::-webkit-scrollbar-thumb:hover {
    background-color: var(--dark-orange);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 12px;
  }

  .gallery-item {
    background-color: var(--transparent-blue);
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    cursor: pointer;
  }

  .item-image-area {
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: var(--transparent-blue);
  }

  .item-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 10px;
    flex-shrink: 0;
  }

  .item-footer.blue-footer {
    background-color: var(--blue);
  }

  .item-footer.orange-footer {
    background-color: var(--orange);
  }

  .item-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .item-title {
    font-family: 'Sora', sans-serif;
    font-weight: 600;
    font-size: 0.72rem;
    color: var(--white);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .item-date {
    font-family: 'Sora', sans-serif;
    font-size: 0.6rem;
    color: rgba(255, 255, 255, 0.7);
  }

  .item-menu {
    background: transparent;
    border: none;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2.5px;
    padding: 4px 6px;
    border-radius: 6px;
    transition: background-color 0.3s ease;
    flex-shrink: 0;
  }

  .item-menu:hover {
    background-color: rgba(255, 255, 255, 0.2);
  }

  .item-menu span {
    display: block;
    width: 3.5px;
    height: 3.5px;
    background-color: var(--white);
    border-radius: 50%;
  }

  @media (max-width: 1100px) {
    .gallery-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (max-width: 860px) {
    .gallery-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 620px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    #panel-header-gallery {
      font-size: 1.1em;
    }
    .search-bar {
      width: 160px;
    }
  }

  @media (max-width: 420px) {
    .gallery-grid {
      grid-template-columns: 1fr;
    }
    #panel-header-gallery {
      flex-wrap: wrap;
      height: auto;
      padding: 10px 16px;
    }
    .search-bar {
      width: 100%;
    }
  }
</style>