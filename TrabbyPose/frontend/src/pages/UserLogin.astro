---
// src/pages/UserLogin.astro
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import TrabahadoorDoorLogo from '../assets/trabahadoor-door-logo.svg?raw'; 
---

<Layout>
  <div class="page-container">
    <div class="section-header"></div>
    <div class="content-container">
      <div id="login-container">
        <div id="login-card">
          <div id="login-header">
            <span id="login-logo"><Fragment set:html={TrabahadoorDoorLogo} /></span>
            <span id="login-text">Login</span>
            <span id="banner-text">
              <span id="welcome-text">Welcome to</span>
              <span id="trabbyhadoor">Trabbyhadoor</span>
              <span id="customizer">Customizer!</span>
            </span>
          </div>

          <div id="user-input">
            <div id="error-message" style="color: red; font-size: 0.9rem; text-align: center; margin-bottom: 1em; display: none;"></div>
            
            <form id="user-fields">
              <div id="username-field" class="input-fields">
                <label for="username">Username</label>
                <input type="text" id="username" name="username" placeholder="Enter Username" required>
              </div>

              <div id="password-field" class="input-fields">
                <label for="password">Password</label>
                <input type="password" id="password" name="password" placeholder="Enter Password" required>
              </div>
              
              <div id="login-button-field">
                <button type="submit" id="login-button">Login</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  const loginForm = document.getElementById('user-fields') as HTMLFormElement;
  const errorMessage = document.getElementById('error-message');

  loginForm?.addEventListener('submit', async (e) => {
    e.preventDefault(); // Stop page from hard reloading
    if (errorMessage) errorMessage.style.display = 'none';

    const formData = new FormData(loginForm);
    const data = Object.fromEntries(formData.entries());

    try {
      // Point this to your Django URL configuration environment variable
      const BACKEND_URL = 'http://127.0.0.1:8000'; 
      
      const response = await fetch(`${BACKEND_URL}/api/auth/login/`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(data),
        // CRITICAL FOR PRODUCTION: Allows cookies to be saved/sent cross-origin
        credentials: 'include', 
      });

      if (response.ok) {
        // Login succeeded, secure HTTP-only cookies are now stored in browser.
        // Redirect to protected customization page
        window.location.href = '/Customization';
      } else {
        const errorData = await response.json();
        throw new Error(errorData.error || 'Failed to authenticate');
      }
    } catch (err: any) {
      if (errorMessage) {
        errorMessage.textContent = err.message || 'Network error occurred.';
        errorMessage.style.display = 'block';
      }
    }
  });
</script>

<style>
  #login-logo :global(svg) {
    width: 4em;       
    height: auto;      
    display: block;      
    margin-bottom: .5em; 
  }
  .page-container{
    font-family: 'Sora', sans-serif;
    font-weight: bold;
    font-size: 1.2em;
    color: var(--blue);
  }
  :global(#nav-links, #nav-actions) {
    display: none !important; 
  }
  #login-container{
    display: flex;
    justify-content: center; 
    align-items: center;    
    height: 80vh;      
    width: 100%;          
  }
  #login-card{
    display: flex;
    flex-direction: column;
    background-color: var(--white);
    box-shadow: var(--default-shadow);
    border-width: 3px;
    border-radius: 20px;
    padding: 2em;
    opacity: 0;
    animation: slideFadeUp 0.8s ease-out 0.1s forwards;
  }
  #login-header{
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }
  #login-text{
    font-size: 2em;
    color: var(--blue);
    margin-bottom: .5em;
  }
  #welcome-text{
    color: var(--grey-text);
    font-weight: normal; 
  }
  #trabbyhadoor{
    color: var(--blue);
  }
  #customizer{
    color:var(--orange)
  }
  #user-fields{
    display: flex;
    flex-direction: column;
  }
  #username, #password{
    background-color: var(--input-text-field);
    border-style: none;
    font-family: 'Sora', sans-serif;    
    color: var(--blue);
    font-size: 16px;      
    font-weight: normal;           
    padding: 0 30px;
    box-sizing: border-box;
  }
  .input-fields{
    padding: 1em 0; 
    display: flex;
    flex-direction: column;
    width: 100%; 
    max-width: 400px; 
    box-sizing: border-box;
  }
  #login-button-field{
    display: flex;
    flex-direction: column;
    width: 100%; 
    max-width: 400px; 
    margin-top: 1em;
    box-sizing: border-box;
  }
  input, button{
    height: 3.2em;
    border-radius: 10px;
    width: 100%;              
    box-sizing: border-box;
  }
  label{
    margin-bottom: .5em;
  }
  #login-button{
    font-family: 'Sora', sans-serif;
    font-weight: bold;
    background-color: var(--orange);
    color: var(--white);
    border-style: none;
    font-size: 1em;
    box-sizing: border-box;
    height: 3em;
    cursor: pointer;
  }

  @keyframes slideFadeUp {
        0% {
            opacity: 0;
            transform: translateY(30px);
        }
        100% {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes simpleFadeIn {
        0% { opacity: 0; }
        100% { opacity: 1; }
    }


  @media (max-width: 900px) {
    .page-container {
      font-size: 0.9em;
    }

    #login-card {
      padding: 2em; 
      width: 90%;
      max-width: 400px;
      box-sizing: border-box;
    }
    
    .input-fields, 
    #login-button-field {
      padding: 0.5em 0;
    }
    
    #banner-text {
      text-align: center;
      line-height: 1.4;
    }
  }
</style>