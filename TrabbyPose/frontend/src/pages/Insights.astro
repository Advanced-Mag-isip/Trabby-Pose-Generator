---
import Layout from '../layouts/Layout.astro';
import BarChart from "../components/BarChart.astro";
import PieChart from "../components/PieChart.astro";
import LineChart from "../components/LineChart.astro";

import {
  getPoseGenerationRate,
  getPredefinedPoseCount,
  getCustomizedPoseCount,
  getTotalPoseCount,
  getTotalPoseSelections,
  getTopPoseRanking,
  getTotalExports,
  getExportsPerMonth,
  getTopExports,
  getSelectionPerPose
} from "../services/insightsApi.js";

// Protected page - check authentication and set no-cache headers
Astro.response.headers.set('Cache-Control', 'no-cache, no-store, must-revalidate, max-age=0');
Astro.response.headers.set('Pragma', 'no-cache');
Astro.response.headers.set('Expires', '0');

/* ---------------------------------------
   FETCH DATA (SSR)
---------------------------------------- */
const [
  poseRate,
  predefined,
  customized,
  totalPoses,
  selections,
  topPoses,
  totalExports,
  exportMonthly,
  topExports,
  usagePerMonth
] = await Promise.all([
  getPoseGenerationRate(),
  getPredefinedPoseCount(),
  getCustomizedPoseCount(),
  getTotalPoseCount(),
  getTotalPoseSelections(),
  getTopPoseRanking(),
  getTotalExports(),
  getExportsPerMonth(),
  getTopExports(),
  getSelectionPerPose()
]);

const monthlyLabels = exportMonthly.labels ?? [];
const monthlyValues = exportMonthly.values ?? [];

const topPoseLabels = topPoses.labels ?? [];
const topPoseValues = topPoses.values ?? [];

const poseRateLabels = poseRate.labels ?? [];
const poseRateValues = poseRate.values ?? [];

const topExportLabels = topExports.labels ?? [];
const topExportValues = topExports.values ?? [];

const usagePerMonthLabels = usagePerMonth.labels ?? [];
const usagePerMonthValues = usagePerMonth.values ?? [];
---

<Layout>
  <div class="page-container">

    <!-- HEADER -->
    <div class="section-header">
      <div class="section-header-line"></div>
      <h1>Insights</h1>
    </div>

    <div class="content-container">

      <!-- ===================================
           POSE GENERATION METRICS
      =================================== -->
      <div id="pose-generation-metrics" class="insights-container">
        <h2>Pose Generation Metrics</h2>

        <div id="outer-pose-generation-container">

          <div id="inner-pose-generation-container">

            <div class="metric-card" id="total-poses-generated">
              <span class="metric">{totalPoses.total_poses_generated}</span>
              <span class="metric-label">Total Poses Generated</span>
            </div>

            <div class="metric-card" id="predefined-poses">
              <span class="metric">{predefined.number_of_predefined_poses}</span>
              <span class="metric-label">Predefined Poses</span>
            </div>

            <div class="metric-card" id="customized-poses">
              <span class="metric">{customized.number_of_customized_poses}</span>
              <span class="metric-label">Customized Poses</span>
            </div>

          </div>

          <div id="pose-generation-per-month" class="graph-card">
            <LineChart
              chartId="pose-generation-chart"
              labels={poseRateLabels}
              values={poseRateValues}
              label="Pose Generation Per Month"
            />
          </div>

        </div>
      </div>

      <!-- ===================================
           POSE USAGE METRICS
      =================================== -->


          <div class="metric-card" id="top-poses">
            <span>Top Poses Breakdown</span>

            <PieChart
              chartId="top-poses-distribution-chart"
              labels={topPoseLabels}
              values={topPoseValues}
              label="Popularity Share"
            />
          </div>

        </div>
      </div>

      <!-- ===================================
           EXPORT METRICS
      =================================== -->
      <div id="export-metric-computation-container" class="insights-container">
        <h2>Export Metrics Computation</h2>

        <div id="outer-export-metric-computation-container">

          <div id="inner-export-metric-computation-container">

            <div class="metric-card" id="total-export">
              <span class="metric-label">Total Exports</span>
              <span class="metric">{totalExports.total_exports}</span>
            </div>

          <div class="metric-card" id="exports-per-pose">
            <PieChart
              chartId="exports-month-chart"
              labels={topExportLabels}
              values={topExportValues}
              label="Top Pose Exports "
            />
          </div>

          </div>

          <div id="exports-per-pose-graph" class="graph-card">
            <LineChart
              chartId="exports-month-chart"
              labels={monthlyLabels}
              values={monthlyValues}
              label="Exports Per Month"
            />
          </div>

        </div>
      </div>

    </div>
  </div>
</Layout>



<style>
    .insights-container{
      margin-bottom: 50px;
      font-family: 'Sora', sans-serif;
    }

   

    .metric{
      font-family: 'Sora', sans-serif;
      font-size: 3em; 
      color: var(--white); 
      font-weight: bold;
    }

    .metric-label{
      font-family: 'Sora', sans-serif;
      font-size: 1.5em; 
      color: var(--white); 
      font-weight: bold;
    }

    h2{
        color: var(--blue);
        font-weight: bold;
    }


    #total-poses-generated{
      background: var(--orange-gradient);
     
    }
    #predefined-poses{
      background: var(--blue-gradient);
    }
    #customized-poses{
      background: var(--orange-gradient);
    }

    #total-export{
      background: var(--blue-gradient);
    }

    #exports-per-pose{
      background: var(--orange-gradient);
    }

    #poses-selected{
      background: var(--white);
      box-shadow: var(--default-shadow);
    }

    #poses-selected .metric{
      color: var(--blue);
    }

    #poses-selected .metric-label{
      color: var(--orange); 
    }

    #selection-per-pose{
      background: var(--orange-gradient);
      color: var(--white);
      font-family: 'Sora', sans-serif;
      font-size: 2em;
      font-weight: bold;
      
    }
  
    #top-poses{
      background: var(--blue-gradient);
      color: var(--white);
      font-family: 'Sora', sans-serif;
      font-size: 2em;
      font-weight: bold;
    }

    
    .insights-container div{
      border-radius: 20px;
    }

    /*==============Pose Generation Metrics Div=========================*/
    #inner-pose-generation-container{
      display: flex;
      flex-direction: row;

      
    }

    #outer-pose-generation-container{
      display: flex;
      flex-direction: column;
      flex-wrap: wrap;
      gap: 30px; 
     
      
    }

    #inner-pose-generation-container span{
      display: flex;
      flex-direction: row;
      padding: 10px; 
    }

    #inner-pose-generation-container div{
      min-width: 250px;
      flex: 1;
      
    }

    #pose-generation-per-week-graph{
      min-height: 400px; 
      display: flex;
      flex-direction: column;
      border: var(--blue);
      border-width: 2px;
      border-style: solid;
      flex: 2;        
    }

    #pose-generation-graph-label{
          box-sizing: border-box;
          background: var(--blue-gradient);
          margin-bottom: auto;
          width: 100%;
          font-family: 'Sora', sans-serif;
          font-weight: bold;
          border-top-left-radius: 20px;
          border-top-right-radius: 20px;
          font-size: 1.7em; 
          color: var(--white);
          padding: .5em; 
    }

    
     /*==============Pose Usage Metrics Div =========================*/
    #inner-pose-usage-metrics{
      display: flex;
      flex-direction: row;
    }

    #inner-pose-usage-metrics div{
      display: flex;
      flex-direction: column;
      padding: 10px;
    }

    #poses-selected{
      min-width: 250;
      min-height: 400px;
      flex: 1; 
      border: 2px solid var(--orange);
    }

    #selection-per-pose, #top-poses{
      min-width: 400px;
      min-height: 380px;
      flex: 1.5;
    }

    .pose-usage-label{
    font-size: .9em; 
    color: var(--white);
    padding: .5em; 
    font-family: 'Sora', sans-serif;
    font-weight: bold;
    margin-bottom: auto;
  }

  

  
   /*==============Export Metrics Computations =========================*/
    #inner-export-metric-computation-container div{
      display: flex;
      flex-direction: column;
      padding: 20px;
      flex: 1;
    }

     #inner-export-metric-computation-container{
      display: flex; 
      flex-direction: column;
      gap: 20px; 
    }

     #outer-export-metric-computation-container{
      display: flex; 
      flex-direction: row;
    }

   #exports-per-pose-graph{ 
      display: flex;
      flex-direction: column;
      
      flex: 2;              
      min-width: 300px;
      min-height: 400px;
   }

   #exports-per-pose-graph-container{
    box-sizing: border-box;
    background: var(--orange-gradient);
    margin-bottom: auto;
    width: 100%;
    font-family: 'Sora', sans-serif;
    font-weight: bold;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    font-size: 1.7em; 
    color: var(--white);
    padding: .5em; 
   }

 

   #inner-pose-generation-container,
    #inner-pose-usage-metrics,
    #outer-export-metric-computation-container {
        display: flex;         
        flex-direction: row;
        flex-wrap: wrap; 
        gap: 20px;
    }

    .metric-card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 24px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        flex: 1;
        min-width: 200px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        box-shadow: var(--default-shadow);
    }

    .metric-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05);
    }

    .graph-card {
        background: #f8fafc;
        border: 2px solid var(--orange);
        border-radius: 12px;
        min-height: 250px;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%; 
        box-shadow: var(--default-shadow);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .graph-card.compact {
        flex: 2;
        min-width: 300px;
        min-height: 200px;
    }

    .graph-card.dynamic-fill {
        flex: 3;
        min-width: 350px;
    }

    .graph-placeholder {
        color: var(--text-muted);
        font-size: 0.95rem;
        font-weight: 500;
    }

     .graph-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05);
    }
</style>