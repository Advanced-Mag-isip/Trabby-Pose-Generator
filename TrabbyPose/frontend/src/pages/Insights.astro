---
// src/pages/Insights.astro
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="page-container">
    <!-- Section Header -->
    <div class="section-header">
      <div class="section-header-line"></div>
      <h1>Insights</h1>
    </div>
    <!-- Content Container -->
    <div class="content-container">
      <!--Pose Generation Metrics Div -->
      <div id = "pose-generation-metrics" class = "insights-container">
        <h2> Pose Generation Metrics</h2>
        <div id = "outer-pose-generation-container">
          <div id = "inner-pose-generation-container">
            
            <div id = "total-poses-generated" class = "metric-card">
            <span class = "metric">21</span>
            <span class = "metric-label">Total Poses Generated</span>
            </div>

            <div id = "predefined-poses" class = "metric-card">
              <span class = "metric">16</span>
              <span class = "metric-label">Predefined Poses</span>
            </div>

            <div id = "customized-poses" class = "metric-card">
              <span class = "metric">05</span>
              <span class = "metric-label">Customized Poses</span>
            </div>
          </div>

          <div id = "pose-generation-per-week-graph" class = "graph-card">
             <!--Insert Graph -->
             <span id = "pose-generation-graph-label">Pose generation per week</span>
            <span>Show Graph</span>
          </div>

        </div>
        

      </div>
       <!--Pose Generation Metrics End-->

      <!--Pose Usage Metrics Div -->
      <div id = "pose-usage-metrics" class = "insights-container">
        <h2>Pose Usage Metrics</h2>
        <div id = "inner-pose-usage-metrics" >
          <div id = poses-selected class = "metric-card">
          <span class = "metric-label">Poses Selected</span>
          <span class = "metric">677</span>
          </div>

        
          <div id = "selection-per-pose" class = "metric-card">
            <span class = "pose-usage-label">Selection Per Post</span>
             <!--Insert Graph -->
            <span>Insert Graph Here</span>
          </div>
          <div id = "top-poses" class = "metric-card">
            <span class = "pose-usage-label">Top Poses</span>
             <!--Insert Graph -->
            <span>Insert Graph Here</span>
          </div>
        </div>
      </div>
      <!--Pose Usage Metrics End -->

      <!-- Export Metrics Computations -->
      <div id = "export-metric-computation-container" class = "insights-container">
        <h2> Export Metrics Computation</h2>
        <div id = "outer-export-metric-computation-container">
            <div id ="inner-export-metric-computation-container">
            <div id = "total-export" class = "metric-card">
           
            <span class = "metric-label" >Total Exports</span>
            <span class = "metric">1367</span>
            </div>

            <div id = "exports-per-pose" class = "metric-card">
              <span class = "metric-label">Exports Per Pose</span>
              <span class = metric>677</span>
            </div>
          </div>
          
          <div id="exports-per-pose-graph" class = "graph-card">
             <span id = "exports-per-pose-graph-container"> Exports per graph</span>
            <span>Insert Graph Here</span>
          </div>
        </div>
      </div>
      <!--Export Metrics Computations End -->
    </div>
  </div>
</Layout>



<style>
    .insights-container{
      margin-bottom: 50px;
      font-family: 'Sora', sans-serif;
    }

   

    .metric{
      font-family: 'Sora', sans-serif;
      font-size: 3em; 
      color: var(--white); 
      font-weight: bold;
    }

    .metric-label{
      font-family: 'Sora', sans-serif;
      font-size: 1.5em; 
      color: var(--white); 
      font-weight: bold;
    }

    h2{
        color: var(--blue);
        font-weight: bold;
    }


    #total-poses-generated{
      background: var(--orange-gradient);
     
    }
    #predefined-poses{
      background: var(--blue-gradient);
    }
    #customized-poses{
      background: var(--orange-gradient);
    }

    #total-export{
      background: var(--blue-gradient);
    }

    #exports-per-pose{
      background: var(--orange-gradient);
    }

    #poses-selected{
      background: var(--white);
      box-shadow: var(--default-shadow);
    }

    #poses-selected .metric{
      color: var(--blue);
    }

    #poses-selected .metric-label{
      color: var(--orange); 
    }

    #selection-per-pose{
      background: var(--orange-gradient);
      color: var(--white);
      font-family: 'Sora', sans-serif;
      font-size: 2em;
      font-weight: bold;
      
    }
  
    #top-poses{
      background: var(--blue-gradient);
      color: var(--white);
      font-family: 'Sora', sans-serif;
      font-size: 2em;
      font-weight: bold;
    }

    
    .insights-container div{
      border-radius: 20px;
    }

    /*==============Pose Generation Metrics Div=========================*/
    #inner-pose-generation-container{
      display: flex;
      flex-direction: row;

      
    }

    #outer-pose-generation-container{
      display: flex;
      flex-direction: column;
      flex-wrap: wrap;
      gap: 30px; 
     
      
    }

    #inner-pose-generation-container span{
      display: flex;
      flex-direction: row;
      padding: 10px; 
    }

    #inner-pose-generation-container div{
      min-width: 250px;
      flex: 1;
      
    }

    #pose-generation-per-week-graph{
      min-height: 400px; 
      display: flex;
      flex-direction: column;
      border: var(--blue);
      border-width: 2px;
      border-style: solid;
      flex: 2;        
    }

    #pose-generation-graph-label{
          box-sizing: border-box;
          background: var(--blue-gradient);
          margin-bottom: auto;
          width: 100%;
          font-family: 'Sora', sans-serif;
          font-weight: bold;
          border-top-left-radius: 20px;
          border-top-right-radius: 20px;
          font-size: 1.7em; 
          color: var(--white);
          padding: .5em; 
    }

    
     /*==============Pose Usage Metrics Div =========================*/
    #inner-pose-usage-metrics{
      display: flex;
      flex-direction: row;
    }

    #inner-pose-usage-metrics div{
      display: flex;
      flex-direction: column;
      padding: 10px;
    }

    #poses-selected{
      min-width: 250;
      min-height: 400px;
      flex: 1; 
      border: 2px solid var(--orange);
    }

    #selection-per-pose, #top-poses{
      min-width: 400px;
      min-height: 380px;
      flex: 1.5;
    }

    .pose-usage-label{
    font-size: .9em; 
    color: var(--white);
    padding: .5em; 
    font-family: 'Sora', sans-serif;
    font-weight: bold;
    margin-bottom: auto;
  }

  

  
   /*==============Export Metrics Computations =========================*/
    #inner-export-metric-computation-container div{
      display: flex;
      flex-direction: column;
      padding: 20px;
      flex: 1;
    }

     #inner-export-metric-computation-container{
      display: flex; 
      flex-direction: column;
      gap: 20px; 
    }

     #outer-export-metric-computation-container{
      display: flex; 
      flex-direction: row;
    }

   #exports-per-pose-graph{ 
      display: flex;
      flex-direction: column;
      
      flex: 2;              
      min-width: 300px;
      min-height: 400px;
   }

   #exports-per-pose-graph-container{
    box-sizing: border-box;
    background: var(--orange-gradient);
    margin-bottom: auto;
    width: 100%;
    font-family: 'Sora', sans-serif;
    font-weight: bold;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    font-size: 1.7em; 
    color: var(--white);
    padding: .5em; 
   }

 

   #inner-pose-generation-container,
    #inner-pose-usage-metrics,
    #outer-export-metric-computation-container {
        display: flex;         
        flex-direction: row;
        flex-wrap: wrap; 
        gap: 20px;
    }

    .metric-card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 24px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        flex: 1;
        min-width: 200px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        box-shadow: var(--default-shadow);
    }

    .metric-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05);
    }

    .graph-card {
        background: #f8fafc;
        border: 2px solid var(--orange);
        border-radius: 12px;
        min-height: 250px;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%; 
        box-shadow: var(--default-shadow);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .graph-card.compact {
        flex: 2;
        min-width: 300px;
        min-height: 200px;
    }

    .graph-card.dynamic-fill {
        flex: 3;
        min-width: 350px;
    }

    .graph-placeholder {
        color: var(--text-muted);
        font-size: 0.95rem;
        font-weight: 500;
    }

     .graph-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05);
    }
</style>