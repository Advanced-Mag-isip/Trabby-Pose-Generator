---
// src/pages/Customization.astro
import { Image } from 'astro:assets';
import IconPencilLine from '../assets/icons/pencil-line.svg?raw';
import IconTrash from '../assets/icons/trash.svg?raw';
import IconRandom from '../assets/icons/dices.svg?raw';
import IconDownload from '../assets/icons/download.svg?raw';
import IconAccessories from '../assets/icons/hammer.svg?raw';
import IconLimbs from '../assets/icons/hand.svg?raw';
import IconShirt from '../assets/icons/shirt.svg?raw';
import IconLaugh from '../assets/icons/laugh.svg?raw';
import IconPreset from '../assets/icons/person-standing.svg?raw';
import Trabby from '../assets/trabby/model/trabby.png';
import Layout from '../layouts/Layout.astro';

import Head1 from '../assets/trabby/sprites/head-1.png';
import Head2 from '../assets/trabby/sprites/head-2.png';
import Face1 from '../assets/trabby/sprites/face-1.png';
import Face2 from '../assets/trabby/sprites/face-2.png';
import Limbs1 from '../assets/trabby/sprites/limbs-1.png';
import Limbs2 from '../assets/trabby/sprites/limbs-2.png';
import Torso1 from '../assets/trabby/sprites/torso-1.png';
import Torso2 from '../assets/trabby/sprites/torso-2.png';
import Acc1 from '../assets/trabby/sprites/acc-1.png';
import Acc2 from '../assets/trabby/sprites/acc-2.png';

import body1 from '../assets/trabby/sprites/official-assets/body/body-1.png';
import body2 from '../assets/trabby/sprites/official-assets/body/body-2.png';
import body3 from '../assets/trabby/sprites/official-assets/body/body-3.png';

import expression1 from '../assets/trabby/sprites/official-assets/expression/expression-1.png';
import expression2 from '../assets/trabby/sprites/official-assets/expression/expression-2.png';
import expression3 from '../assets/trabby/sprites/official-assets/expression/expression-3.png';
import expression4 from '../assets/trabby/sprites/official-assets/expression/expression-4.png';
import expression5 from '../assets/trabby/sprites/official-assets/expression/expression-5.png';
import expression6 from '../assets/trabby/sprites/official-assets/expression/expression-6.png';
import expression7 from '../assets/trabby/sprites/official-assets/expression/expression-7.png';
import expression8 from '../assets/trabby/sprites/official-assets/expression/expression-8.png';
import expression9 from '../assets/trabby/sprites/official-assets/expression/expression-9.png';
import expression10 from '../assets/trabby/sprites/official-assets/expression/expression-10.png';
import expression11 from '../assets/trabby/sprites/official-assets/expression/expression-11.png';
import expression12 from '../assets/trabby/sprites/official-assets/expression/expression-12.png';
import expression13 from '../assets/trabby/sprites/official-assets/expression/expression-13.png';
import expression14 from '../assets/trabby/sprites/official-assets/expression/expression-14.png';
import expression15 from '../assets/trabby/sprites/official-assets/expression/expression-15.png';

// Protected page - check authentication and set no-cache headers
Astro.response.headers.set('Cache-Control', 'no-cache, no-store, must-revalidate, max-age=0');
Astro.response.headers.set('Pragma', 'no-cache');
Astro.response.headers.set('Expires', '0');

---

<Layout>
  <div class="page-container">
    <!-- Section Header -->
    <div class="section-header">
      <div class="section-header-line"></div>
      <h1>Trabby Customization</h1>
    </div>
    <!-- Content Container -->
    <div class="content-container">
      <!-- LEFT Character Preview Panel -->
      <div id="panel-customization-preview">
        <div id="panel-header-preview">Character Preview</div>
        <div class="character-preview-actions">
          <div class="input-wrapper">
            <span class="input-icon" set:html={IconPencilLine}></span>
            <input type="text" placeholder="Image Name" />
          </div>
          <div class="action-buttons">
            <button id = "delete-btn" set:html={IconTrash} aria-label="Delete"></button>
            <button id = "randomize-btn" set:html={IconRandom} aria-label="Randomize"></button>
            <button id="download-btn" set:html={IconDownload} aria-label="Download"></button>
          </div>
        </div>
        <div id="character-preview-display" class="character-preview-display">
          <!-- <Image src={Trabby} alt="Character Preview" /> -->
        </div>
        <div class="character-preview-selections">
          <div class="selection-category hover-effect"></div>
          <div class="selection-category hover-effect"></div>
          <div class="selection-category hover-effect"></div>
          <div class="selection-category hover-effect"></div>
        </div>
      </div>

      <!-- RIGHT Customization Options Panel -->
      <div class="spacer">
        <div id="panel-customization-options">
          <div id="panel-header-options">Customization</div>
          <div class="category-scroll-wrapper">
            <button id="scroll-left" class="scroll-btn scroll-btn-left hidden" aria-label="Scroll left">&#8249;</button>
            <div id="category-container"></div>
            <button id="scroll-right" class="scroll-btn scroll-btn-right hidden" aria-label="Scroll right">&#8250;</button>
          </div>
          <div class="options-container">
            <div id="options-contents"></div>
          </div>
        </div>
        <div class="tabs-container">
          <div class="options-tabs" set:html={IconLaugh}></div>
          <div class="options-tabs" set:html={IconLimbs}></div>
          <div class="options-tabs" set:html={IconShirt}></div>
          <div class="options-tabs" set:html={IconAccessories}></div>
          <div class="options-tabs" set:html={IconPreset}></div>
        </div>
      </div> 
    </div>
    <div id="deletion-modal" class="hidden">
            <div class="modal-content">
                <h3>Clear Canvas?</h3>
                <p>All assets will be removed?</p>
              <div class="modal-actions">
                  <button id="cancel-deletion-btn" class = "cancel-btn">Cancel</button>
                  <button id="confirm-deletion-btn" class = "confirm-btn">Yes</button>
              </div>
            </div>
       </div>

        <div id="save-modal" class="hidden">
            <div class="modal-content">
                <h3>Download configuration as a .png?</h3>
                <p>A .png file will be downloaded to your device </p>
            <div class="modal-actions">
                <button id="cancel-save-btn" class = "cancel-btn">Cancel</button>
                <button id="confirm-save-btn" class = "confirm-btn" >Yes</button>
            </div>     
          </div>
        </div>

        <div id="empty-modal" class="hidden">
            <div class="modal-content">
                <h3>Can't download from blank canvas</h3>
                <p>Please select at least one asset before downloading</p>
            <div class="modal-actions">
                <button id="confirm-save-btn" class = "confirm-btn" >Ok</button>
            </div>     
          </div>
        </div>

        <div id="randomize-modal" class="hidden">
            <div class="modal-content">
                <h3>Randomize configuration?</h3>
                <p>Current configuration will be replaced</p>
            <div class="modal-actions">
                <button id="cancel-randomize-btn" class = "cancel-btn">Cancel</button>
                <button id="confirm-randomize-btn" class = "confirm-btn">Yes</button>
            </div>
           </div>
      </div>
  </div>
</Layout>

<script>
  import "../services/eventHooks.js";
</script>

<style>
   .hidden {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background-color: rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(4px);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 9999;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
    }


    #save-modal.show, #deletion-modal.show, #randomize-modal.show, #empty-modal.show{
        opacity: 1;
        pointer-events: all;
    }

    .modal-content {
        background-color: var(--white, #ffffff);
        padding: 30px;
        border-radius: 12px;
        text-align: center;
        box-shadow: 0 10px 25px rgba(0,0,0,0.2);
        max-width: 400px;
        width: 90%;
    }

    .modal-content h3 {
        margin-top: 0;
        color: var(--blue, #000);
    }

    .modal-actions {
        display: flex;
        justify-content: center;
        gap: 15px;
        margin-top: 20px;
    }

    .modal-actions button {
        padding: 10px 20px;
        border-radius: 2rem;
        border: none;
        font-weight: bold;
        cursor: pointer;
        transition: background-color 0.2s;
    }

    .cancel-btn {
        background-color: var(--light-gray, #e0e0e0);
        color: #333;
    }

    .confirm-btn {
        background-color: var(--orange, #ff6b00);
        color: white;
    }


  .content-container {
    display: flex;
    flex-direction: row;
    justify-content: center;
    gap: 1em;
    flex-wrap: wrap;
  }

  #panel-customization-preview {
    background-color: var(--white);
    flex: 1 1 320px;
    min-width: 280px;
    max-width: 500px;
    max-height: 700px;
    border-radius: 24px;
    border: 4px solid var(--orange);
    overflow: hidden;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.3);
    display: flex;
    flex-direction: column;
    height: clamp(450px, 80vh, 630px);
    opacity: 0;
    animation: slideFadeUp 0.8s ease-out 0.1s forwards;
  }

  /* ── RIGHT PANEL ── */
  #panel-customization-options {
    z-index: 1;
    position: relative;
    margin-left: 80px;
    background-color: var(--white);
    flex: 2 1 400px;
    min-width: 320px;
    border-radius: 24px;
    border: 4px solid var(--blue);
    overflow: hidden;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.3);
    display: flex;
    flex-direction: column;
    height: clamp(450px, 80vh, 630px);
  }

  #panel-header-preview {
    background-color: var(--orange);
  }
  #panel-header-options {
    background-color: var(--blue);
  }
  #panel-header-preview, #panel-header-options {
    color: var(--white);
    height: 36px;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: start;
    padding: 10px 20px;
    font-family: 'Sora', sans-serif;
    font-weight: bold;
    font-size: 1.3em;
    flex-shrink: 0;
  }

  .character-preview-actions {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    padding: 10px 20px;
    flex-shrink: 0;
  }
  .character-preview-actions button {
    background-color: var(--blue);
    color: var(--white);
    border: none;
    border-radius: 12px;
    padding: 10px;
    cursor: pointer;
    display: flex; 
    align-items: center;
    justify-content: center;
    transition: background-color 0.3s ease;
  }
  .character-preview-actions button:hover {
    background-color: var(--orange);
  }
  .character-preview-actions button :global(svg) {
    width: 24px;
    height: 24px;
    outline: currentColor;
  }
  .character-preview-actions input {
    border: none;
    background: transparent;
    color: var(--blue);
    font-family: 'Sora', sans-serif;
    font-weight: bold;
    font-size: 16px;
    outline: none;
    width: 100%;
    min-width: 0;
  }
  .character-preview-actions input::placeholder {
    color: #94a3b8;
    font-weight: normal;
  }
  .input-wrapper {
    display: flex;
    align-items: center;
    gap: 10px;
    background-color: transparent;
    color: var(--blue);
    border: 3px solid var(--blue);
    border-radius: 12px;
    padding: 5px 12px;
    flex: 1;
    min-width: 0;
  }
  .input-icon :global(svg) {
    width: 20px;
    height: 20px;
    fill: currentColor;
    flex-shrink: 0;
  }
  .action-buttons {
    display: flex;
    gap: 5px;
    flex-shrink: 0;
  }

  .character-preview-display {
    flex: 1;
    min-height: 200px;
    background-color: #ffffff;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    position: relative;
  }
  .character-preview-display img {
    max-width: 75%;
    max-height: 75%;
    object-fit: contain;
  }

  .character-preview-selections {
    flex-shrink: 0;
    display: flex;
    justify-content: center;
    gap: 10px;
    padding: 10px;
    width: 100%;
    box-sizing: border-box;
  }
  .selection-category {
    background-color: transparent;
    border: 4px solid var(--orange);
    border-radius: 10px;
    flex: 1;
    max-width: 4.5em;
    aspect-ratio: 1;
    min-width: 0;
    position: relative;
    overflow: hidden;
    transition: background-color 0.3s ease;
  }
  .selection-category:hover {
    background-color: color-mix(in srgb, var(--orange) 20%, transparent);
  }

  .spacer {
    position: relative;
    flex: 2 1 400px;
    min-width: 320px;
    display: flex;
    opacity: 0;
    animation: slideFadeUp 0.8s ease-out 0.1s forwards;
  }

  .tabs-container {
    position: absolute;
    top: 72px;
    left: 18px;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .options-tabs {
    position: relative; 
    z-index: 0;
    background-color: var(--blue);
    color: var(--white);
    border: 4px solid transparent;
    border-right: none;
    padding: 20px 16px; 
    border-radius: 16px 0px 0px 16px;
    font-family: 'Sora', sans-serif;
    font-weight: bold;
    cursor: pointer;
    transition: all 0.3s ease;
  }
  .options-tabs:hover {
    border: 4px solid var(--blue);
    background-color: var(--white);
    color: var(--blue);
    font-weight: bold;
    cursor: pointer;
    padding-right: 26px;
    transform: translateX(-10px);
  }
  .options-tabs :global(svg) {
    width: 32px;
    height: 32px;
    outline: currentColor;
  }

  .options-tabs.tab-active {
    border: 4px solid var(--blue);
    background-color: var(--white);
    color: var(--blue);
    padding-right: 26px;
    transform: translateX(-10px);
  }

  .category-scroll-wrapper {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 5px 15px;
    flex-shrink: 0;
    position: relative;
  }
  #category-container {
    display: flex;
    gap: 10px;
    align-items: center;
    flex-shrink: 0;
    flex: 1;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    scroll-behavior: smooth;
    padding: 10px;
    position: relative;
  }
  #category-container::-webkit-scrollbar {
    display: none;
  }
  .scroll-btn {
    flex-shrink: 0;
    position: absolute;
    z-index: 2;
    background-color: transparent;
    color: var(--white);
    border: none;
    padding: 4px 10px 14px 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    text-shadow: #000000;
    cursor: pointer;
    font-size: 64px;
    line-height: 0.5;
    transition: background-color 0.3s ease, opacity 0.3s ease;
    backdrop-filter: blur(10px);
  }
  .scroll-btn-left  { left: 0px; border-radius: 0px 10px 10px 0px; transition: all 0.3s ease;}
  .scroll-btn-left:hover  { padding-left: 24px; }
  .scroll-btn-right { right: 0px; border-radius: 10px 0px 0px 10px; transition: all 0.3s ease;}
  .scroll-btn-right:hover  { padding-right: 24px; }
  .scroll-btn:hover {
    background-color: #F26B2A;
  }
  .scroll-btn.hidden {
    opacity: 0;
    pointer-events: none;
  }

  .options-container {
    padding: 16px;
    flex-grow: 1; 
    margin-right: 8px;
    overflow-y: auto; 
    overflow-x: hidden;
  }
  #options-contents {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
    gap: 16px;
    width: 100%;
    padding-bottom: 20px;
  }

  @keyframes slideFadeUp {
    0% {
      opacity: 0;
      transform: translateY(30px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes simpleFadeIn {
    0% { opacity: 0; }
    100% { opacity: 1; }
  }


  @media (max-width: 768px) {
    .spacer {
      width: 100%;
      padding-left: 60px;
      box-sizing: border-box;
    }

    #panel-customization-options {
      margin-left: 0;
      width: 100%;
      max-width: 100%;
      height: clamp(400px, 60vh, 600px);
    }

    .tabs-container {
      left: 0;
      top: 40px;
    }

    .options-tabs :global(svg) {
      width: 24px;
      height: 24px;
    }
  }
</style>

<style is:global>
  .category-btn {
    background-color: var(--transparent-blue);
    padding: 8px 24px;
    border: 4px solid var(--blue);
    border-radius: 100px;
    color: var(--blue);
    font-family: 'Sora', sans-serif;
    font-weight: bold;
    font-size: 1em;
    transition: all 0.3s ease;
    white-space: nowrap;
  }
  .category-btn:hover {
    background-color: var(--transparent-orange);
    border: 4px solid var(--orange);
    color: var(--blue);
    cursor: pointer;
  }
  .category-btn.active {
    background-color: var(--orange);
    border: 4px solid transparent;
    color: var(--white);
  }
  .option-item {
    background-color: var(--transparent-blue);
    aspect-ratio: 1;
    border: 4px solid transparent;
    border-radius: 16px;
    display: flex;
    justify-content: center;
    align-items: center;
    color: var(--blue);
    font-family: 'Sora', sans-serif;
    font-weight: bold;
    transition: all 0.3s ease;
    text-align: center;
    padding: 8px;
  }
  .option-item:hover {
    background-color: var(--transparent-orange);
    border: 4px solid var(--orange);
    cursor: pointer;
  }
  .option-item.option-selected {
    background-color: var(--transparent-orange);
    border: 4px solid var(--orange);
  }
  .summary-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.2;
    pointer-events: none;
  }
  .summary-placeholder :global(svg) {
    width: 60%;
    height: 60%;
    fill: currentColor;
  }
</style>

<script define:vars={{
  spriteMap: {
    'head-1': Head1.src,
    'head-2': Head2.src,
    'face-1': Face1.src,
    'face-2': Face2.src,
    'limbs-1': Limbs1.src,
    'limbs-2': Limbs2.src,
    'torso-1': Torso1.src,
    'torso-2': Torso2.src,
    'acc-1': Acc1.src,
    'acc-2': Acc2.src,
    'body1': body1.src,
    'body2': body2.src,
    'body3': body3.src,
    'expression1': expression1.src,
    'expression2': expression2.src,
    'expression3': expression3.src,
    'expression4': expression4.src,
    'expression5': expression5.src,
    'expression6': expression6.src,
    'expression7': expression7.src,
    'expression8': expression8.src,
    'expression9': expression9.src,
    'expression10': expression10.src,
    'expression11': expression11.src,
    'expression12': expression12.src,
    'expression13': expression13.src,
    'expression14': expression14.src,
    'expression15': expression15.src,
  },
  tabIcons: {
    Head: IconLaugh,
    Limbs: IconLimbs,
    Torso: IconShirt,
    Accessories: IconAccessories,
  }
}}>
  window.__SPRITE_MAP__ = spriteMap;
  window.__TAB_ICONS__ = tabIcons;
</script>

<script is:inline>
 
  function setupCustomization() {
    document.addEventListener('astro:page-load', () => {
    downloadPreview();
    randomize(); 
    resetCanvas(); 
  });

    // Only run if we are actually on the customization page
    const categoryContainer = document.getElementById("category-container");
    const optionsContents = document.getElementById("options-contents");
    
    if (!categoryContainer || !optionsContents) return;

    // Constants and Data
    const TABS = {
      Head: {
        subcategories: ["Head Position", "Eyes", "Mouth", "Face"],
        options: {
          "Head Position": ["head-1", "head-2", "Tilted Right", "Looking Up", "Looking Down", "Bowed"],
          "Eyes": ["Round Eyes", "Sleepy Eyes", "Star Eyes", "Heart Eyes", "Dot Eyes", "Winking"],
          "Mouth": ["Smile", "Grin", "Pout", "Open Mouth", "Smirk", "Frown"],
          "Face": ["face-1", "face-2", "Star Eyes", "Heart Eyes", "Dot Eyes", "Winking"],
        }
      },
      Limbs: {
        subcategories: [
          "Left Arm", "Right Arm", "Left Leg", "Right Leg", "Tail", "Limbs"
        ],
        options: {
          "Left Arm": ["Default", "Raised", "Lowered", "Crossed", "Flexed"],
          "Right Arm": ["Default", "Raised", "Lowered", "Crossed", "Flexed"],
          "Left Leg": ["Open Hand", "Fist", "Peace Sign", "Pointing", "Wave"],
          "Right Leg": ["Open Hand", "Fist", "Peace Sign", "Pointing", "Wave"],
          "Tail": ["No Tail", "Short Tail", "Long Tail", "Curly Tail", "Wagging Tail"],
          "Limbs": ["limbs-1", "limbs-2"],
        }
      },
      Torso: {
        subcategories: ["Torso Shape"],
        options: {
          "Torso Shape": ["torso-1", "torso-2", "Chubby", "Slim", "Muscular", "Round", "Tiny"],
        }
      },
      Accessories: {
        subcategories: ["Wearables",],
        options: {
          "Wearables": ["acc-1", "acc-2", "Scarf", "Bowtie", "Necklace", "Cape", "Backpack", "Hat", "Glasses", "Apron", "Hoodie"],
        }
      },
      Presets: {
        subcategories: ["Face Presets", "Pose Presets"],
        options: {
          "Face Presets": ["expression1", "expression2", "expression3", "expression4", "expression5", "expression6", "expression7", "expression8", "expression9", "expression10", "expression11", "expression12", "expression13", "expression14", "expression15", "Happy", "Sad", "Angry", "Surprised", "Sleepy"],
          "Pose Presets": ["body1", "body2", "body3", "Confident", "Running", "Back"],
        }
      }

    };
    const TAB_ORDER = ["Head", "Limbs", "Torso", "Accessories", "Presets"];
    const LAYER_Z = { 
      Torso: 10, 
      Limbs: 30, 
      Accessories: 50,

      "Head Position": 20,
      "Ears": 21,
      "Face": 22,
      "Eyes": 23,
      "Mouth": 24,
      "Eyebrows": 25,
      "Hair": 26,
      
      "Pose Presets": 40,
      "Face Presets": 41,
    };

    // State Management (Restoring from sessionStorage)
    let activeTab = "Head";
    let activeSubcategory = TABS["Head"].subcategories[0];
    const lastVisitedSubcategory = {
      Head: "Head Position",
      Limbs: "Limbs",
      Torso: "Torso Shape",
      Accessories: "Wearables",
      Presets: "Face Presets"
    };
    
    const savedSelections = sessionStorage.getItem('trabbySelections');
    let previewSelections = savedSelections ? JSON.parse(savedSelections) : {};

    let recentCategorySelections = sessionStorage.getItem('trabbyRecentSelections') 
      ? JSON.parse(sessionStorage.getItem('trabbyRecentSelections')) 
      : {};

    // Functions
    function updateScrollButtons() {
      const leftBtn = document.getElementById("scroll-left");
      const rightBtn = document.getElementById("scroll-right");
      if (!leftBtn || !rightBtn) return;
      leftBtn.classList.toggle("hidden", categoryContainer.scrollLeft <= 0);
      rightBtn.classList.toggle("hidden",
        categoryContainer.scrollLeft + categoryContainer.clientWidth >= categoryContainer.scrollWidth - 1
      );
    }

    function renderCategories() {
      const subs = TABS[activeTab].subcategories;
      document.getElementById("panel-header-options").textContent = `Customization: ${activeTab}`;
      categoryContainer.innerHTML = subs.map(sub => `
        <button 
          class="category-btn hover-effect${sub === activeSubcategory ? ' active' : ''}" 
          data-sub="${sub}"
        >${sub}</button>
      `).join("");

      categoryContainer.querySelectorAll(".category-btn").forEach(btn => {
        btn.addEventListener("click", () => {
          activeSubcategory = btn.dataset.sub;
          lastVisitedSubcategory[activeTab] = activeSubcategory;
          renderCategories();
          renderOptions();
        });
      });

      categoryContainer.removeEventListener("scroll", updateScrollButtons);
      categoryContainer.addEventListener("scroll", updateScrollButtons);

      document.getElementById("scroll-left").onclick = () => {
        categoryContainer.scrollBy({ left: -150, behavior: "smooth" });
      };
      document.getElementById("scroll-right").onclick = () => {
        categoryContainer.scrollBy({ left: 150, behavior: "smooth" });
      };

      setTimeout(updateScrollButtons, 50);
    }

    function updateSummaryBoxes() {
      const boxes = document.querySelectorAll(".selection-category");
      const mapping = ["Head", "Limbs", "Torso", "Accessories"]; 
      
      boxes.forEach((box, index) => {
        const tabName = mapping[index];
        const recentSprite = recentCategorySelections[tabName];
        
        if (recentSprite) {
          box.innerHTML = `<img src="${recentSprite}" alt="${tabName} selection" style="position:absolute;inset:0;width:100%;height:100%;object-fit:contain;pointer-events:none;" />`;
        } else {
          const iconSvg = window.__TAB_ICONS__?.[tabName] ?? '';
          box.innerHTML = `<div class="summary-placeholder">${iconSvg}</div>`;
        }
      });
    }

    function setPreviewLayer(tab, subcategory, spriteUrl) {
      previewSelections[subcategory] = { tab, spriteUrl };
      sessionStorage.setItem('trabbySelections', JSON.stringify(previewSelections));

      if (["Head", "Limbs", "Torso", "Accessories"].includes(tab)) {
        recentCategorySelections[tab] = spriteUrl;
        sessionStorage.setItem('trabbyRecentSelections', JSON.stringify(recentCategorySelections));
        updateSummaryBoxes();
      }

      renderPreviewLayers();
    }

    function renderPreviewLayers() {
      const display = document.querySelector(".character-preview-display");
      if (!display) return;
      
      display.querySelectorAll(".preview-layer").forEach(el => el.remove());

      Object.entries(previewSelections).forEach(([sub, { tab, spriteUrl }]) => {
        if (!spriteUrl) return;
        const img = document.createElement("img");
        img.src = spriteUrl;
        img.alt = sub;
        img.className = "preview-layer";
        img.style.cssText = `
          position: absolute;
          inset: 0;
          width: 100%;
          height: 100%;
          object-fit: contain;
          z-index: ${LAYER_Z[sub] ?? LAYER_Z[tab] ?? 1};
          pointer-events: none;
        `;
        display.appendChild(img);
      });
    }

    function renderOptions() {
      const items = TABS[activeTab].options[activeSubcategory] || [];

      const isNoneSelected = !previewSelections[activeSubcategory]?.spriteUrl;
      const noneTile = `<div class="option-item hover-effect ${isNoneSelected ? 'option-selected' : ''}" data-item="__none__" data-sprite="">
        <span style="font-size:1em; opacity:0.4;">none</span>
      </div>`;

      const itemTiles = items.map(item => {
        const spriteUrl = window.__SPRITE_MAP__?.[item];
        const content = spriteUrl
          ? `<img src="${spriteUrl}" alt="${item}" style="width:80%;height:80%;object-fit:contain;" />`
          : item;

        const isSelected = spriteUrl
          ? previewSelections[activeSubcategory]?.spriteUrl === spriteUrl
          : false;

        return `<div class="option-item hover-effect ${isSelected ? 'option-selected' : ''}" data-item="${item}" data-sprite="${spriteUrl || ''}">${content}</div>`;
      }).join("");

      optionsContents.innerHTML = noneTile + itemTiles;

      optionsContents.querySelectorAll(".option-item").forEach(el => {
        el.addEventListener("click", () => {
          if (el.dataset.item === "__none__") {
            delete previewSelections[activeSubcategory];
            sessionStorage.setItem('trabbySelections', JSON.stringify(previewSelections));

            // Check if any selections remain for this tab; if not, clear the summary box
            const remainingEntry = Object.values(previewSelections).find(v => v.tab === activeTab && v.spriteUrl);
            if (remainingEntry) {
              recentCategorySelections[activeTab] = remainingEntry.spriteUrl;
            } else {
              delete recentCategorySelections[activeTab];
            }
            sessionStorage.setItem('trabbyRecentSelections', JSON.stringify(recentCategorySelections));

            renderPreviewLayers();
            renderOptions();
            updateSummaryBoxes();
            return;
          }

          const sprite = el.dataset.sprite;
          if (!sprite) return;
          setPreviewLayer(activeTab, activeSubcategory, sprite);

          optionsContents.querySelectorAll(".option-item").forEach(e => e.classList.remove("option-selected"));
          el.classList.add("option-selected");
        });
      });
    }

function downloadPreview() {
    const downloadBtn = document.getElementById("download-btn");
    const modal = document.getElementById("save-modal");
    const cancelBtn = document.getElementById('cancel-save-btn');
    const confirmBtn = document.getElementById('confirm-save-btn');


    

    // 1. Show the modal when clicking the Download icon
    if (downloadBtn && modal && !downloadBtn.dataset.listenerAttached) {
        downloadBtn.addEventListener('click', (e) => {
            e.preventDefault();
            modal.classList.add('show');
        });
        downloadBtn.dataset.listenerAttached = "true";
    }

    // 2. Hide the modal when clicking Cancel
    if (cancelBtn && modal && !cancelBtn.dataset.listenerAttached) {
        cancelBtn.addEventListener('click', () => {
            modal.classList.remove('show');
        });
        cancelBtn.dataset.listenerAttached = "true";
    }

    // 3. Process the Canvas and Download when clicking Confirm
    if (confirmBtn && modal && !confirmBtn.dataset.listenerAttached) {
        confirmBtn.addEventListener('click', async (e) => {
            e.preventDefault(); 

            const display = document.querySelector(".character-preview-display");
            
            // Safety check in case the DOM isn't ready
            if (!display) return;

            const layers = Array.from(display.querySelectorAll(".preview-layer"))
                .sort((a, b) => parseInt(a.style.zIndex || '0') - parseInt(b.style.zIndex || '0'));

            // Assuming previewSelections is defined globally somewhere else in your script
            if (typeof previewSelections !== 'undefined') {
                window.__PREVIEW_SELECTIONS__ = previewSelections;
            }

            // If there's nothing to download, just close the modal
            if (layers.length === 0) {
                modal.classList.remove('show');
                return; 
            }

            const refImg = layers[0];
            const width = refImg.naturalWidth || 512;
            const height = refImg.naturalHeight || 512;

            const canvas = document.createElement("canvas");
            canvas.width = width;
            canvas.height = height;
            const ctx = canvas.getContext("2d");

            layers.forEach(img => {
                ctx.drawImage(img, 0, 0, width, height);
            });

            const nameInput = document.querySelector(".character-preview-actions input");
            const filename = nameInput?.value?.trim() || "trabby";

            canvas.toBlob(blob => {
                const url = URL.createObjectURL(blob);
                const a = document.createElement("a");
                a.href = url;
                a.download = `${filename}.png`;
                a.click();
                URL.revokeObjectURL(url);
                
               
                modal.classList.remove('show');
            }, "image/png");
        });
        confirmBtn.dataset.listenerAttached = "true";
    }
}


  function randomize() {
  const SPRITE_KEYS = Object.keys(window.__SPRITE_MAP__ || {});
  // read the sprites actually loaded in the assetsd
  const CUSTOM_ASSETS = {
    "Head Position": SPRITE_KEYS.filter(k => k.startsWith("head-")),
    "Face": SPRITE_KEYS.filter(k => k.startsWith("face-")),
    "Limbs": SPRITE_KEYS.filter(k => k.startsWith("limbs-")),
    "Torso Shape": SPRITE_KEYS.filter(k => k.startsWith("torso-")),
    "Wearables": SPRITE_KEYS.filter(k => k.startsWith("acc-")),
  };

  const PRESET_BODIES = SPRITE_KEYS.filter(k => k.startsWith("body"));
  const PRESET_EXPRESSIONS = SPRITE_KEYS.filter(k => k.startsWith("expression"));

  const randomizeBtn= document.getElementById("randomize-btn");
  const modal = document.getElementById("randomize-modal");
  const cancelBtn = document.getElementById('cancel-randomize-btn');
  const confirmBtn = document.getElementById('confirm-randomize-btn');

   if (randomizeBtn && modal && !randomizeBtn.dataset.listenerAttached) {
        randomizeBtn.addEventListener('click', (e) => {
            e.preventDefault();
            modal.classList.add('show');
        });
        randomizeBtn.dataset.listenerAttached = "true";
  }

  if (cancelBtn && modal && !cancelBtn.dataset.listenerAttached) {
        cancelBtn.addEventListener('click', () => {
            modal.classList.remove('show');
        });
        cancelBtn.dataset.listenerAttached = "true";
  }


  function pick(arr) {
    return arr[Math.floor(Math.random() * arr.length)];
  }
  
  if (confirmBtn && modal && !confirmBtn.dataset.listenerAttached) {
        confirmBtn.addEventListener('click', async (e) => {
            e.preventDefault(); 

              const usePreset = Math.random() < 0.5;

              // Clear all current selections first
              previewSelections = {};
              recentCategorySelections = {};

              if (usePreset) {
                // --- Preset path: one Body + one Expression ---
                const bodyKey = pick(PRESET_BODIES);
                const exprKey = pick(PRESET_EXPRESSIONS);
                const bodyUrl = window.__SPRITE_MAP__[bodyKey];
                const exprUrl = window.__SPRITE_MAP__[exprKey];

                if (bodyUrl) { previewSelections["Body"] = { tab: "Presets", spriteUrl: bodyUrl  }; }
                if (exprUrl) { previewSelections["Expressions"] = { tab: "Presets", spriteUrl: exprUrl  }; }

              } else {
                const picks = {
                  "Head Position": { tab: "Head", assets: CUSTOM_ASSETS["Head Position"] },
                  "Face": { tab: "Head", assets: CUSTOM_ASSETS["Face"] },
                  "Limbs": { tab: "Limbs", assets: CUSTOM_ASSETS["Limbs"] },
                  "Torso Shape": { tab: "Torso", assets: CUSTOM_ASSETS["Torso Shape"] },
                  "Wearables": { tab: "Accessories", assets: CUSTOM_ASSETS["Wearables"] },
                };

                Object.entries(picks).forEach(([sub, { tab, assets }]) => {
                  if (!assets.length) return;
                  const key = pick(assets);
                  const url = window.__SPRITE_MAP__[key];
                  if (url) {
                    previewSelections[sub] = { tab, spriteUrl: url };
                    if (["Head Position", "Limbs", "Torso Shape", "Wearables"].includes(sub)) {
                      const tabKey = { "Head Position": "Head", "Limbs": "Limbs", "Torso Shape": "Torso", "Wearables": "Accessories" }[sub];
                      if (tabKey) recentCategorySelections[tabKey] = url;
                    }
                  }
                });
              }

                // Persist + re-render everything
                sessionStorage.setItem('trabbySelections', JSON.stringify(previewSelections));
                sessionStorage.setItem('trabbyRecentSelections', JSON.stringify(recentCategorySelections));

                renderPreviewLayers();
                renderOptions();
                updateSummaryBoxes();

                   
                modal.classList.remove('show');
        });
        confirmBtn.dataset.listenerAttached = "true";
    }

  // Randomly decide which combo type to use

  }

    // Event Listeners for Tabs
    document.querySelectorAll(".options-tabs").forEach((tab, i) => {
      const newTab = tab.cloneNode(true);
      tab.parentNode.replaceChild(newTab, tab);
      
      newTab.addEventListener("click", () => {
        activeTab = TAB_ORDER[i];
        activeSubcategory = lastVisitedSubcategory[activeTab];
        renderCategories();
        renderOptions();
        
        document.querySelectorAll(".options-tabs").forEach(t => t.classList.remove("tab-active"));
        newTab.classList.add("tab-active");
      });
    });

    const summaryBoxes = document.querySelectorAll(".selection-category");
    const boxMapping = ["Head", "Limbs", "Torso", "Accessories"]; // Matches order in HTML
    
    summaryBoxes.forEach((box, i) => {
      const newBox = box.cloneNode(true); // Prevent duplicate listeners
      box.parentNode.replaceChild(newBox, box);
      
      newBox.addEventListener("click", () => {
        // Find which tab this box corresponds to
        const targetTab = boxMapping[i];
        const tabIndex = TAB_ORDER.indexOf(targetTab);
        
        if (tabIndex !== -1) {
          activeTab = targetTab;
          activeSubcategory = lastVisitedSubcategory[activeTab];
          
          // Render new menus
          renderCategories();
          renderOptions();
          
          // Visually highlight the correct tab on the right side
          document.querySelectorAll(".options-tabs").forEach(t => t.classList.remove("tab-active"));
          document.querySelectorAll(".options-tabs")[tabIndex].classList.add("tab-active");
        }
      });
      
      // Make it obvious they are clickable
      newBox.style.cursor = "pointer";
    });

    // Init Buttons
    const downloadBtn = document.querySelector('[aria-label="Download"]');
    if (downloadBtn) {
      const newDownloadBtn = downloadBtn.cloneNode(true);
      downloadBtn.parentNode.replaceChild(newDownloadBtn, downloadBtn);
      newDownloadBtn.addEventListener("click", downloadPreview);
    }

    const randomBtn = document.querySelector('[aria-label="Randomize"]');
    if (randomBtn) {
      const newRandomBtn = randomBtn.cloneNode(true);
      randomBtn.parentNode.replaceChild(newRandomBtn, randomBtn);
      newRandomBtn.addEventListener("click", randomize);
    }

    const deleteBtn = document.querySelector('[aria-label="Delete"]');
    if (deleteBtn) {
      const newDeleteBtn = deleteBtn.cloneNode(true);
      deleteBtn.parentNode.replaceChild(newDeleteBtn, deleteBtn);
      newDeleteBtn.addEventListener("click", resetCanvas);
    }


    function resetCanvas(){
      const deleteBtn = document.getElementById("delete-btn");
      const modal = document.getElementById("deletion-modal");
      const cancelBtn = document.getElementById('cancel-deletion-btn');
      const confirmBtn = document.getElementById('confirm-deletion-btn');
     
       if (deleteBtn && modal && !deleteBtn.dataset.listenerAttached) {
          deleteBtn.addEventListener('click', (e) => {
            e.preventDefault();
            modal.classList.add('show');
        });
        deleteBtn.dataset.listenerAttached = "true";
      }

       if (cancelBtn && modal && !cancelBtn.dataset.listenerAttached) {
        cancelBtn.addEventListener('click', () => {
            modal.classList.remove('show');
        });
        cancelBtn.dataset.listenerAttached = "true";
      }

       if (confirmBtn && !confirmBtn.dataset.listenerAttached) {
        confirmBtn.addEventListener('click', async (e) => {
            e.preventDefault();

            previewSelections = {};
            sessionStorage.removeItem('trabbySelections');
            
            recentCategorySelections = {};
            sessionStorage.removeItem('trabbyRecentSelections');
            updateSummaryBoxes();
            
            renderPreviewLayers();
            renderOptions();
             modal.classList.remove('show');
        });}


    }
    
    
    // Set initial visual active state for the default Head tab
    const firstTab = document.querySelectorAll(".options-tabs")[0];
    if(firstTab) firstTab.classList.add("tab-active");

    renderCategories();
    renderOptions();
    renderPreviewLayers();
    updateSummaryBoxes();
    document.getElementById("panel-header-options").textContent = `Customization: ${activeTab}`;
  }

  // Hook into Astro's View Transitions lifecycle
  document.addEventListener('astro:page-load', setupCustomization);
</script>